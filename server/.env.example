PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Optional: configure these to have the contact form actually send you an email.
# If left blank, submissions are still validated and saved to server/data/messages.json.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=mohamad.majd.br@icloud.com

# Admin dashboard at /admin. Required to enable it; pick a long, unique password.
ADMIN_PASSWORD=
# Optional: signing key for admin sessions (defaults to a value derived from ADMIN_PASSWORD).
ADMIN_SECRET=

# Optional: PostgreSQL connection string for production (Neon, Supabase, Render, Railway...).
# If blank, messages are stored in a local SQLite file at server/data/portfolio.db.
DATABASE_URL=
